FROM (
    SELECT [d].[Id], [d].[Bio], [d].[CreatedAtUtc], [d].[Designation], [d].[ExperienceYears], [d].[Fee], [d].[Qualification], [d].[Room], [d].[SpecializationId], [d].[UserId], [u].[Id] AS [Id0], [u].[CreatedAtUtc] AS [CreatedAtUtc0], [u].[Email], [u].[FullName], [u].[IsActive], [u].[LastLoginAtUtc], [u].[PasswordHash], [u].[Phone], [u].[PhotoUrl], [u].[Role]
