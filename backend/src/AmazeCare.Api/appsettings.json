{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=AmazeCare;User Id=sa;Password=AmazeCare@12345;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "AmazeCare.Api",
    "Audience": "AmazeCare.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "SecureSocketOptions": "StartTls",
    "UserName": "",
    "Password": "",
    "FromAddress": "care@amazecare.test",
    "FromName": "AmazeCare"
  },
  "App": {
    "ClinicName": "AmazeCare",
    "ClinicAddress": "100 Feet Road, Indiranagar, Bengaluru 560038",
    "ClinicPhone": "+91 80 4123 8800",
    "ClinicEmail": "care@amazecare.test",
    "Gstin": "",
    "FrontendBaseUrl": "http://localhost:5173",
    "PasswordResetMinutes": 30,
    "PasswordResetMaxPerHour": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Database": {
    "AutoMigrate": true,
    "SeedDemoData": true
  },
  "Api": {
    "HttpsRedirect": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/amazecare-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
